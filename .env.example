# Copy this to .env.local and fill in real values.
# Both keys come from Supabase Dashboard > Project Settings > API.

# Anon (public) key — safe to expose in client bundles.
# RLS policies in the DB protect what this key can read/write.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE
